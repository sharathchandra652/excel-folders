# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
# Where the daily report goes (comma-separated for more than one address)
REPORT_EMAIL=
# Long random text; generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Claude model for summaries. claude-haiku-5-5 costs about 40x less; see SETUP.md.
CLAUDE_MODEL=claude-opus-5-5
START_DATE=2026-11-01
